# ==============================================================================
# KongSwap Kong RPC Proxy Container
# Multi-stage build for Rust application
# ==============================================================================

# Stage 1: Builder - Compile Rust application
# ==============================================================================
FROM rust:1.85-slim-bookworm AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency manifests first for caching
COPY kong_rpc/Cargo.toml kong_rpc/Cargo.lock ./

# Create dummy src to build dependencies only
RUN mkdir -p src && echo "fn main() {}" > src/main.rs

# Build dependencies (this layer gets cached)
RUN cargo build --release 2>/dev/null || true
RUN rm -rf src

# Copy actual source code
COPY kong_rpc/src ./src

# Clear incremental build cache to force recompilation
RUN rm -rf target/release/.fingerprint/kong_rpc* target/release/deps/kong_rpc* target/release/deps/libkong_rpc* 2>/dev/null || true

# Build release binary
RUN cargo build --release

# Verify binary exists
RUN ls -lh target/release/kong_rpc

# ==============================================================================
# Stage 2: Runtime - Minimal image
# ==============================================================================
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libpq5 \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/target/release/kong_rpc /usr/local/bin/kong_rpc

# Create non-root user for security
RUN useradd -m -u 1000 kongrpc && chown -R kongrpc:kongrpc /app

# Health check - verify process is running (with longer start period for initialization)
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=6 \
    CMD pgrep kong_rpc || exit 1

# Run as non-root user
USER kongrpc

# Default command
CMD ["kong_rpc"]
